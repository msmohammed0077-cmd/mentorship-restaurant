  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "browserFlow": "browser-email-otp",
  "registrationFlow": "registration-without-password",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@restaurant.local",
    "fromDisplayName": "Restaurant"
  },
  "defaultRole": {
    "name": "default-roles-restaurant"
  },
  "authenticatorConfig": [
    {
      "alias": "email-otp",
      "config": {
        "code-length": "6",
        "code-alphabet": "0123456789",
        "code-lifetime": "600",
        "resend-cooldown": "60",
        "issuance-limit": "5",
        "issuance-limit-window": "900",
        "trust-only-when-sole": "true",
        "ip-trust-enabled": "false",
        "device-trust-enabled": "false"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-email-otp",
      "description": "Cookie, else email then a code sent to it. No password.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "browser-email-otp forms",
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-email-otp forms",
      "description": "The email, then the code.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "email-otp-form",
          "authenticatorConfig": "email-otp",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "registration-without-password",
      "description": "Email, first and last name; no password step.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "registration-page-form",
          "authenticatorFlow": true,
          "flowAlias": "registration-without-password form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "registration-without-password form",
      "description": "The registration form: the user profile only.",
      "providerId": "form-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "registration-user-creation",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    }
  ]
}
