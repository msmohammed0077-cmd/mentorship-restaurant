{
  "realm": "restaurant",
  "enabled": true,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Orders food: their profile, addresses, cards, cart and orders.",
        "composite": true,
        "composites": {
          "client": {
            "restaurant-api": [
              "customer.read",
              "customer.write",
              "address.read",
              "address.write",
              "payment-method.read",
              "payment-method.write",
              "cart.read",
              "cart.write",
              "order.create",
              "order.read",
              "order.cancel",
              "order.rate"
            ]
          }
        }
      },
      {
        "name": "RESTAURANT_OWNER",
        "description": "Runs a restaurant's orders: accept, reject, prepare.",
        "composite": true,
        "composites": {
          "client": {
            "restaurant-api": [
              "order.read",
              "order.accept",
              "order.reject",
              "order.prepare"
            ]
          }
        }
      },
      {
        "name": "ADMIN",
        "description": "Every permission. Ownership guards still apply (#83 part 2 decides).",
        "composite": true,
        "composites": {
          "client": {
            "restaurant-api": [
              "customer.read",
              "customer.write",
              "address.read",
              "address.write",
              "payment-method.read",
              "payment-method.write",
              "cart.read",
              "cart.write",
              "order.create",
              "order.read",
              "order.cancel",
              "order.rate",
              "order.accept",
              "order.reject",
              "order.prepare"
            ]
          }
        }
      },
      {
        "name": "default-roles-restaurant",
        "description": "Given to every new user: sign-ups are customers.",
        "composite": true,
        "composites": {
          "realm": [
            "CUSTOMER"
          ]
        }
      }
    ],
    "client": {
      "restaurant-api": [
        {
          "name": "customer.read",
          "description": "View a customer profile"
        },
        {
          "name": "customer.write",
          "description": "Update or delete a customer"
        },
        {
          "name": "address.read",
          "description": "List a customer's addresses"
        },
        {
          "name": "address.write",
          "description": "Add, change, delete or default an address"
        },
        {
          "name": "payment-method.read",
          "description": "List a customer's saved cards"
        },
        {
          "name": "payment-method.write",
          "description": "Add, delete or default a saved card"
        },
        {
          "name": "cart.read",
          "description": "View a cart"
        },
        {
          "name": "cart.write",
          "description": "Add, change, remove or clear cart items; check out"
        },
        {
          "name": "order.create",
          "description": "Place an order"
        },
        {
          "name": "order.read",
          "description": "View an order or order history"
        },
        {
          "name": "order.cancel",
          "description": "Cancel an order"
        },
        {
          "name": "order.rate",
          "description": "Rate a delivered order"
        },
        {
          "name": "order.accept",
          "description": "Accept an incoming order"
        },
        {
          "name": "order.reject",
          "description": "Reject an incoming order"
        },
        {
          "name": "order.prepare",
          "description": "Mark an order preparing or ready for pickup"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "restaurant-api",
      "name": "Restaurant API",
      "description": "The audience the API checks. No login flow of its own.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "restaurant-swagger",
      "name": "Swagger UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/swagger-ui/oauth2-redirect.html",
        "http://localhost:8081/swagger-ui/oauth2-redirect.html",
        "http://localhost:8082/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "restaurant-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "restaurant-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
